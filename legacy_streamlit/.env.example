# === LLM Provider ===
# openai | gemini
LLM_PROVIDER=openai

# === OpenAI ===
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1

# === Gemini (LLM_PROVIDER=gemini 일 때만 사용, STT 는 항상 OpenAI Whisper) ===
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-1.5-flash

# === App ===
DB_URL=sqlite:///ainote.db
APP_TITLE=AI Note - 업무 관리 대시보드
# API 키가 없을 때 목업 응답으로 동작 (True 권장: 키 없이도 전체 플로우 시연 가능)
ALLOW_MOCK_AI=True
