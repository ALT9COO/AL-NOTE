# === AI 프로바이더 ===
# 여기 값은 최초 실행 시 초기값으로만 쓰이며, 이후에는 설정 → API 연동 화면에서 저장한 키가 우선합니다.
# 키가 하나도 없으면 ALLOW_MOCK_AI=True 설정으로 데모(mock) 응답이 사용됩니다.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_STT_MODEL=whisper-1
# Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# Gemini (https://aistudio.google.com/app/apikey) — AIza 로 시작하는 API 키
GOOGLE_API_KEY=
ALLOW_MOCK_AI=True

# === Auth ===
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# 로그인 유지(remember) 토큰 유효 기간. 기본 14일.
REMEMBER_TOKEN_EXPIRE_DAYS=14
# DB에 저장하는 API 키·OAuth 토큰 암호화 키. 비우면 JWT_SECRET에서 파생합니다.
ENCRYPTION_KEY=

# === Microsoft 365 캘린더 (Graph 위임 연동) ===
# Azure Portal → Microsoft Entra ID → 앱 등록에서 만든 값.
# 여기 대신 설정 → 캘린더 연동 화면(ADMIN)에서 입력해도 되며, 화면 값이 우선합니다.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# 단일 테넌트면 디렉터리(테넌트) ID, 여러 조직/개인 계정도 허용하려면 common
MS_TENANT_ID=common
# Azure 앱 등록의 '웹' 플랫폼 리디렉션 URI — localhost와 사내 IP를 모두 등록하세요.
MS_REDIRECT_URI=https://localhost:3001/api/calendar/callback
# 예: MS_REDIRECT_URI=https://10.10.120.50:3001/api/calendar/callback
# 로그인 후 사용자를 돌려보낼 프런트엔드 주소 (OAuth state에 접속 주소가 저장되므로 보통 자동)
FRONTEND_URL=https://localhost:3001

# === App ===
DATABASE_URL=sqlite:///./ainote.db
CORS_ORIGINS=https://localhost:3001,https://127.0.0.1:3001
